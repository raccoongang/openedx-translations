msgstr "Виберіть опцію конфігурації дедлайну"

#: templates/legacy/edit/oa_edit_schedule.html:13
msgid " NEW"
msgstr " НОВИНКА"

#: templates/legacy/edit/oa_edit_schedule.html:19
