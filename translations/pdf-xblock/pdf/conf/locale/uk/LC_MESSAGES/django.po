#: pdf/pdf.py:30
msgid "Display Name"
msgstr "Назва, що відображається"

#: pdf/pdf.py:33 pdf/templates/html/pdf_edit.html:10
msgid "This name appears in the horizontal navigation at the top of the page."
msgstr ""
"Ця назва відображається в горизонтальній навігації у верхній частині "
"сторінки."

#: pdf/pdf.py:37 pdf/templates/html/pdf_edit.html:15
msgid "PDF URL"
msgstr "Посилання на PDF-файл"

#: pdf/pdf.py:40 pdf/templates/html/pdf_edit.html:18
msgid "The URL for your PDF."
msgstr "Посилання на ваш PDF-файл."

#: pdf/pdf.py:44
msgid "PDF Download Allowed"
msgstr "Завантаження PDF дозволено"

#: pdf/pdf.py:47
msgid "Display a download button for this PDF."
msgstr "Показувати кнопку завантаження для цього PDF."

#: pdf/pdf.py:51 pdf/templates/html/pdf_edit.html:24
msgid "Source document button text"
msgstr "Текст кнопки документа-першоджерела"

#: pdf/pdf.py:55 pdf/pdf.py:65 pdf/templates/html/pdf_edit.html:31
msgid ""
"Add a download link for the source file of your PDF. Use it for example to "
"provide the PowerPoint file used to create this PDF."
msgstr ""
"Додайте посилання для завантаження файлу-джерела вашого PDF. Наприклад, щоб "
"надати файл PowerPoint, з якого створено цей PDF."

#: pdf/pdf.py:61 pdf/templates/html/pdf_edit.html:28
msgid "Source document URL"
msgstr "Посилання на документ-першоджерело"

#: pdf/templates/html/pdf_edit.html:7
msgid "Name"
msgstr "Назва"

#: pdf/templates/html/pdf_edit.html:25
msgid "Default : Download the source document"
msgstr "Типово: Завантажити документ-першоджерело"

#: pdf/templates/html/pdf_edit.html:40
msgid "Save"
msgstr "Зберегти"

#: pdf/templates/html/pdf_edit.html:43
msgid "Cancel"
msgstr "Відмінити"

#: pdf/templates/html/pdf_view.html:11
msgid "It appears you don't have a PDF plugin for this browser."
msgstr "Здається, у вас немає плагіна PDF для цього браузера."

#: pdf/templates/html/pdf_view.html:17
msgid "Download the PDF"
msgstr "Завантажити PDF-файл"

#: pdf/templates/html/pdf_view.html:21
msgid "Download the source document"
msgstr "Завантажити документ-першоджерело"
