#: dynamic_pages/admin.py
msgid "Preview"
msgstr "Попередній перегляд"

#: dynamic_pages/apps.py
msgid "Dynamic pages"
msgstr "Динамічні сторінки"

#: dynamic_pages/models.py
msgid "Site"
msgstr "Сайт"

#: dynamic_pages/models.py
#, python-format
msgid "%(path)s (deleted site)"
msgstr "%(path)s (сайт видалено)"

#: dynamic_pages/models.py
msgid "Path"
msgstr "Шлях"

#: dynamic_pages/models.py
msgid ""
"A path starting with /, e.g. / or /about. Use lowercase Latin letters, "
"digits, hyphens and underscores."
msgstr ""
"Шлях, що починається з /, наприклад / або /about. Використовуйте малі "
"латинські літери, цифри, дефіси та підкреслення."

#: dynamic_pages/models.py
msgid "Content"
msgstr "Контент"

#: dynamic_pages/models.py
msgid "HTML or a Mako template."
msgstr "HTML або шаблон Mako."

#: dynamic_pages/models.py
msgid "Is published"
msgstr "Опубліковано"

#: dynamic_pages/models.py
msgid "Dynamic page"
msgstr "Динамічна сторінка"

#: dynamic_pages/models.py
msgid "Can preview unpublished dynamic pages"
msgstr "Може переглядати неопубліковані динамічні сторінки"

#: dynamic_pages/models.py
msgid "Can publish dynamic page and edit published dynamic pages"
msgstr "Може публікувати динамічні сторінки та редагувати опубліковані"

#: dynamic_pages/models.py
msgid "Editor"
msgstr "Редактор"

#: dynamic_pages/models.py
msgid "Reviewer"
msgstr "Рецензент"

#: dynamic_pages/models.py
msgid "User"
msgstr "Користувач"

#: dynamic_pages/models.py
msgid "Role"
msgstr "Роль"

#: dynamic_pages/models.py
msgid "Granted staff status"
msgstr "Надано статус персоналу"

#: dynamic_pages/models.py
msgid ""
"Whether the user got staff status with this access, so removing the access "
"takes it away."
msgstr ""
"Чи отримав користувач статус персоналу разом із цим доступом; тоді "
"видалення доступу забирає його."

#: dynamic_pages/models.py
msgid "Dynamic page access"
msgstr "Доступ до динамічних сторінок"

#: dynamic_pages/models.py
msgid "Dynamic page accesses"
msgstr "Доступи до динамічних сторінок"

#: dynamic_pages/utils.py
msgid "The path must start with /, e.g. /about."
msgstr "Шлях має починатися з /, наприклад /about."

#: dynamic_pages/utils.py
msgid "The path can't have empty parts (//)."
msgstr "Шлях не може містити порожніх частин (//)."

#: dynamic_pages/utils.py
#, python-format
msgid ""
"“%(segment)s” can't be part of a path; use lowercase Latin letters, digits, "
"hyphens and underscores, e.g. “%(slug)s”."
msgstr ""
"«%(segment)s» не може бути частиною шляху; використовуйте малі латинські "
"літери, цифри, дефіси та підкреслення, наприклад «%(slug)s»."

#: dynamic_pages/utils.py
#, python-format
msgid ""
"“%(segment)s” can't be part of a path; use lowercase Latin letters, digits, "
"hyphens and underscores."
msgstr ""
"«%(segment)s» не може бути частиною шляху; використовуйте малі латинські "
"літери, цифри, дефіси та підкреслення."

#: dynamic_pages/utils.py
#, python-format
msgid "The content isn't a valid Mako template: %(error)s"
msgstr "Контент не є коректним шаблоном Mako: %(error)s"
